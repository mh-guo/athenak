# AthenaK input: Newtonian xray_binary MHD (poloidal mean field in donor envelope)
# Accretor at origin, donor on +x; Roche polytropic IC + corotating-frame sources.
#
# Purpose:
#   MHD counterpart to scherbak_q05_mid_heat geometry; B from mean_field=poloidal.
#   Same mesh scale as the hydro reference (128^3, nghost=4).
#
# Geometry (same scale as Scherbak q_0.5 reference):
#   q = 0.5           -> m_accretor/m_donor = 1/2
#   x0 = 0.43         -> r_donor/a_sep = 0.43
#   gamma = 1.4
#
# Magnetic options (independent; both off => B=0):
#   mean_field = none|poloidal   # donor-envelope poloidal A
#   <turb_seed_*> blocks         # one-shot dens/vel/pres/bfld seeds
# fix_donor: reset fluid in mask; MHD also sets E=0 on mask edges (CT-frozen B, divB=0).
#
# poloidal A: A_phi_phys = R^{r_pow} (rho - rho_cut)^{rho_pow}
#   R = cyl. radius about donor z. rho_pow>=1: no B spike at the cut; r_pow>=1: B finite on axis.
#   For mid-envelope ~constant beta on this point-mass polytrope, use
#     rho_pow = 1,  r_pow = gamma / (2*(gamma-1))   (1.75 when gamma=1.4).
#   potential_beta_min = min(p/p_mag) in r_mask < r < r_donor and rho > cut.
#   rho_cut ~ 1e-5 is ~0.91 R on L1 (outside mask, off the surface).
#
# turb_seed_bfld notes:
#   Window r_in ~ r_donor_mask, r_out < r_donor (avoid surface).
#   amp_rpow shapes |B| radial envelope via potential; for d << R and gamma=1.4,
#   p ~ d^{-3.5}, uniform-beta target |B| ~ sqrt(p) ~ d^{-1.75} (try amp_rpow ~ -1.75;
#   -3.5 tracks p itself and undershoots outer |B| relative to that target).
#
# Production: nlim = -1. Quick check: set nlim = 2 (or small) and lower output dcycle.

<comment>
problem   = x-ray binary MHD (turb_seed bfld in donor envelope)
reference = same geometry as scherbak_q05_mid_heat; hydro/MHD dual path + turb_seed

<job>
basename  = xrb

<mesh>
nghost = 4          # Number of ghost cells
nx1    = 128        # number of cells in x1-direction
x1min  = -4194304   # minimum x1  (2^22)
x1max  =  4194304   # maximum x1  (2^22)
ix1_bc = user       # inner boundary
ox1_bc = user       # outer boundary

nx2    = 128        # number of cells in x2-direction
x2min  = -4194304   # minimum x2
x2max  =  4194304   # maximum x2
ix2_bc = user       # inner boundary
ox2_bc = user       # outer boundary

nx3    = 128        # number of cells in x3-direction
x3min  = -4194304   # minimum x3
x3max  =  4194304   # maximum x3
ix3_bc = user       # inner boundary
ox3_bc = user       # outer boundary

<meshblock>
nx1  = 32           # Number of cells in each MeshBlock, X1-dir
nx2  = 32           # Number of cells in each MeshBlock, X2-dir
nx3  = 32           # Number of cells in each MeshBlock, X3-dir

<mesh_refinement>
refinement = static    # type of refinement
#refinement       = adaptive  # type of refinement
#max_nmb_per_rank = 1072      # max allowed number of MBs per device (memory limit for AMR)
#cycle_check     = 1         # cycles between checking mesh for ref/derefinement
#refinement_interval = 1      # cycles between allowing successive ref/derefinement
#num_levels       = 23

<refined_region1>
#level = 22
level = 4           # accretor region
x1min = -1.0
x1max =  1.0
x2min = -1.0
x2max =  1.0
x3min = -1.0
x3max =  1.0

<refined_region2>
#level = 22
level = 4           # donor region
x1min = -0.50e6
x1max = 1.50e6
x2min = -0.25e6
x2max =  0.25e6
x3min = -0.25e6
x3max =  0.25e6

<time>
evolution  = dynamic     # dynamic/kinematic/static
integrator = rk2         # time integration algorithm
cfl_number = 0.25        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1          # cycle limit (-1 = no limit)
tlim       = 1.0e12      # time limit
ndiag      = 10          # cycles between diagnostic output

<coord>
general_rel = false      # general relativity
a           = 0.0        # black hole spin a (0 <= a/M < 1)
excise      = false      # excise r_ks <= 1.0 (GR only)
dexcise     = 1.0e-5     # density inside excision
pexcise     = 2.0e-11    # pressure inside excision

<mhd>
eos         = ideal      # EOS type
reconstruct = ppm4       # spatial reconstruction method
rsolver     = hlld       # Riemann-solver (hlld for MHD)
dfloor      = 1.0e-10    # floor on density rho
pfloor      = 5.0e-19    # floor on gas pressure p_gas
tfloor      = 5.0e-10    # floor on gas temperature, 5e-10 = 3.3e3 K
rdfloor     = 1.0e-4     # radius-dependent floor on density rho
rdfloor_rad = 1.0e0      # radius at which rdfloor is applied
rdfloor_pow = -2.0       # power-law index for rdfloor
gamma       = 1.4        # ratio of specific heats Gamma
fofc        = true       # Enable first order flux correction
gamma_max   = 20.0       # Enable ceiling on Lorentz factor
sigma_max   = 1.0e4      # ceiling on magnetization

<units>
bhmass_msun = 1.0e1      # black hole mass in solar masses
density_cgs = 1.0e-10    # density unit (cgs)
mu          = 0.618      # mean molecular weight

<problem>
a_sep      = 1.0e6       # binary separation; donor at (+a_sep, 0, 0)
m_donor    = 2.0         # donor mass (paper q=0.5)
m_accretor = 1.0         # accretor mass at origin
r_donor    = 4.3e5       # donor radius (r_donor/a_sep = 0.43)
fix_donor  = true        # fix fluid in mask; MHD: E=0 on mask edges (frozen B)
r_donor_mask = 2.0e5     # donor inner mask radius
r_soft     = 1.0e4       # Newtonian accretor gravity softening
k_adi      = 1.0e-5      # polytrope constant K in p = K rho^Gamma
rho_min    = 1.0e-9      # background on rho given by rho_min ...
rho_pow    = -0.0        # ... * r^rho_pow
pgas_min   = 1.0e-14     # background on p_gas given by pgas_min ...
pgas_pow   = -0.0        # ... * r^pgas_pow
user_srcs  = true        # enable Roche corotating-frame source terms
user_hist  = true        # enroll user history (accretor + donor fluxes)
#flux_radius_donor = 4.515e5  # donor flux sphere (default 1.05*r_donor; must > r_donor_mask)
heating    = true        # Scherbak 2025 Eq. (7) envelope heating
heat_f_ext = 1.5e-3      # M_ext / M_gas (Eq. 11); Scherbak ~1e-3 in normalized units
t_kh       = 3.03e11     # KH timescale (Eq. 12); default ~525/Omega
#heat_phi_surface = ...  # default: Phi at (a_sep - r_donor, 0, 0)
#heat_t0 = ...            # default: 15/Omega
#heat_dt_ramp = ...       # default: 5/Omega

# Mean magnetic field: none | poloidal (donor-envelope A_phi loops)
mean_field = none
#mean_field = poloidal
#potential_beta_min = 100.0   # min(p/p_mag) in live envelope (outside mask)
#potential_rho_cut  = 1.0e-5  # A=0 for rho < cut (~0.91 R on L1)
#potential_rho_pow  = 1.0     # A_phi ~ (rho - cut)^pow  (>=1; no cut-surface spike)
$potential_r_pow    = 1.75    # A_phi_phys ~ R^{r_pow};  gamma/(2*(gamma-1)) for gamma=1.4

# Weak turbulent B seed in donor envelope (r_in ≳ r_donor_mask)
<turb_seed_bfld>
field    = bfld          # vel|dens|pres|bfld
inv_beta = 0.01          # <p_mag>/<p_gas> of seed in window
x1_0     = 1.0e6         # window center = donor (a_sep, 0, 0)
x2_0     = 0.0
x3_0     = 0.0
r_in     = 2.1e5         # ~ r_donor_mask (avoid seeding deep inside mask)
r_out    = 3.6e5         # < r_donor to avoid surface effects
dr_in    = 2.0e4         # inner taper
dr_out   = 4.0e4         # outer taper
nlow     = 2             # mode range vs l_turb (default 2*r_out)
nhigh    = 8
expo     = 1.6667
amp_rpow = -3.5
seed     = 1

# Optional dens/vel seeds (example; leave commented for pure B smoke):
#<turb_seed_dens>
#field    = dens
#amp      = 0.02
#x1_0     = 1.0e6
#r_in     = 2.0e5
#r_out    = 4.3e5
#nlow     = 1
#nhigh    = 3
#seed     = 2

<output1>
file_type = log         # diagnostic data
dcycle    = 100         # cycle increment between outputs

<output2>
file_type  = hst        # History output
data_format = %13.6e    # Optional data format string
#dt         = 1.0e1      # time increment between outputs
dcycle     = 200        # cycle increment between outputs

<output3>
file_type  = rst        # Restart dump
#dt         = 1.0e3      # time increment between outputs
dcycle     = 10000      # cycle increment between outputs

<output4>
file_type  = bin        # Binary data dump
id         = full       # output id tag
variable   = mhd_w_bcc  # variables to be output
#dt         = 1.0e3      # time increment between outputs
dcycle     = 10000      # cycle increment between outputs

<output5>
file_type  = cbin       # Coarsened binary data dump
id         = full       # output id tag
coarsen_factor = 2      # coarsen factor for binary output
variable   = mhd_w_bcc  # variables to be output
#dt         = 1.0e3      # time increment between outputs
dcycle     = 10000      # cycle increment between outputs

<output6>
file_type  = bin        # Binary data dump
id         = heat       # output id tag
variable   = xrb_heat   # cell-by-cell heating rate (Scherbak Eq. 7)
#dt         = 1.0e3      # time increment between outputs
dcycle     = 10000      # cycle increment between outputs
