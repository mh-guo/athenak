# AthenaK input file for Magnetized Bondi accretion with cyclic zoom

<comment>
problem   = GRMHD Bondi accretion

<job>
basename  = bondi      # problem ID: basename of output filenames
reference = Guo et al., ApJ 987, 202 (2025)

<mesh>
nghost    = 4          # Number of ghost cells
nx1       = 128        # Number of zones in X1-direction
x1min     = -16777216  # minimum value of X1
x1max     = 16777216   # maximum value of X1
ix1_bc    = user       # inner-X1 boundary flag
ox1_bc    = user       # outer-X1 boundary flag

nx2       = 128        # Number of zones in X2-direction
x2min     = -16777216  # minimum value of X2
x2max     = 16777216   # maximum value of X2
ix2_bc    = user       # inner-X2 boundary flag
ox2_bc    = user       # outer-X2 boundary flag

nx3       = 128        # Number of zones in X3-direction
x3min     = -16777216  # minimum value of X3
x3max     = 16777216   # maximum value of X3
ix3_bc    = user       # inner-X3 boundary flag
ox3_bc    = user       # outer-X3 boundary flag

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<mesh_refinement>
refinement       = adaptive  # type of refinement
max_nmb_per_rank = 1352      # max allowed number of MBs per device (memory limit for AMR)
ncycle_check     = 1         # cycles between checking mesh for ref/derefinement
refinement_interval = 1      # cycles between allowing successive ref/derefinement
num_levels       = 23

<refined_region1>
level = 22
x1min = -1.0
x1max = 1.0
x2min = -1.0
x2max = 1.0
x3min = -1.0
x3max = 1.0

<amr_criterion1>
method      = cyclic_zoom   # refinement criterion
nlevels     = 15            # number of levels for zoom data
emf_fmax    = 1.0           # maximum electric field factor
f_cut       = 0.4           # factor for cutting the zoom region
r_cut_max   = 1.0e10        # maximum radius for cutting the zoom region
r_0         = 1.0           # radius of zoom region at zone 0
trun_fac    = 20.0          # default interval factor (trun = trun_fac * M^trun_pow)
trun_pow    = 1.5           # power for interval (trun = trun_fac * M^trun_pow)
trun_fac_0  = 500.0         # interval factor for zone 0
trun_fac_1  = 0.0           # interval factor for zone 1
trun_fac_2  = 0.0           # interval factor for zone 2
trun_max    = 2.0e7         # maximum interval

<cyclic_zoom>
verbose     = true          # enable verbose output

<coord>
general_rel = true       # general relativity
a           = 0.0        # black hole spin a (0 <= a/M < 1)
excise      = true       # excise r_ks <= 1.0
dexcise     = 1.0e-8     # density inside excision
pexcise     = 0.333e-12  # pressure inside excision

<time>
evolution  = dynamic     # dynamic/kinematic/static
integrator = rk2         # time integration algorithm
cfl_number = 0.20        # The Courant, Friedrichs, & Lewy (CFL) Number
gr_dt      = true        # enable general relativity time step
nlim       = -1          # cycle limit
tlim       = 2.0e9       # time limit
ndiag      = 10          # cycles between diagostic output

<mhd>
eos         = ideal      # EOS type
reconstruct = ppm4       # spatial reconstruction method
rsolver     = hlle       # Riemann-solver to be used
gamma       = 1.66666666667   # gamma = C_p/C_v
dfloor      = 1.0e-4     # floor on density rho
pfloor      = 1.0e-10    # floor on gas pressure p_gas
tfloor      = 3.0e-7     # floor on gas temperature
sfloor      = 1.0e-10    # floor on gas entropy
sigma_max   = 1.0e4      # ceiling on magnetic field
gamma_max   = 10.0       # ceiling on Lorentz factor
fofc        = true       # Enable first order flux correction

<problem>
ic_type    = 1           # initial condition type: 0 for gr bondi, 1 for uniform
k_adi      = 1.0         # adiabat K, p_gas = K rho^Gamma
r_crit     = 336.6       # sonic point radius, in units of mass, T_inf = 3e-6 = 2e7 K
temp_inf   = 3.0e-6      # temperature at infinity, 2e7 K, r_B = 2GM/c_s^2 = 4.0e5
dens_inf   = 1.0e0       # density at infinity, 1.0
b_ini      = 2.0e-3      # uniform Bz; beta_inf = 1
r_in       = 1.0         # inner radius of the problem
pert_amp   = 2.0e-2      # amplitude of perturbation
user_hist  = true        # user history output
hist_nr    = 91          # number of radial bins in user-defined history
hist_nintp = 4           # number of points for interpolation

<output1>
file_type   = log        # diagnostic data
dcycle      = 100        # cycle increment between outputs

<output2>
file_type   = hst        # history data dump
data_format = %15.8e     # Optional data format string
dcycle      = 1000       # cycle increment between outputs

<output3>
file_type   = rst        # restart data dump
dcycle      = 10000      # cycle increment between outputs

<output4>
file_type   = bin        # binary data dump
id          = full       # output id tag
variable    = mhd_w_bcc  # variables to be output
dcycle      = 10000      # cycle increment between outputs

<output5>
file_type  = bin        # Binary data dump
variable   = mhd_w_bcc  # variables to be output
id         = slice_x1   # file identifier
dcycle     = 10000      # cycle increment between outputs
slice_x1   = 0.0        # slice at x1

<output6>
file_type  = bin        # Binary data dump
variable   = mhd_w_bcc  # variables to be output
id         = slice_x2   # file identifier
dcycle     = 10000      # cycle increment between outputs
slice_x2   = 0.0        # slice at x2

<output7>
file_type  = bin        # Binary data dump
variable   = mhd_w_bcc  # variables to be output
id         = slice_x3   # file identifier
dcycle     = 10000      # cycle increment between outputs
slice_x3   = 0.0        # slice at x3
